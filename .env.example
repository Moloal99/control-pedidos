APP_NAME="Control de Pedidos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8020
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------ base local
# Desarrollo: SQLite. Produccion: MariaDB/MySQL (ver docs/04-DESPLIEGUE.md)
DB_CONNECTION=sqlite
# DB_CONNECTION=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=control_pedidos
# DB_USERNAME=control_pedidos
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync en desarrollo; database en produccion (el programador de tareas la procesa)
QUEUE_CONNECTION=sync
CACHE_STORE=database

# ------------------------------------------------------------------ negocio
# demo: datos locales de prueba, sin SharePoint ni correo real
# sharepoint: SharePoint es la fuente de verdad (requiere la app de Entra ID)
PEDIDOS_MODO=demo
CENTRAL_URL=https://central.plasticoscarmen.com
# Copia oculta en todos los avisos (la Power App copiaba a un consultor externo).
# Dejar vacio hasta que la empresa lo autorice.
PEDIDOS_COPIA_EXTERNA=

# ------------------------------------------------------------------ Microsoft 365
# Guia paso a paso: docs/03-GUIA-ENTRA-ID.md
MS_TENANT_ID=27250769-1586-414b-8402-5536efdbfa8a
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Certificado (recomendado; necesario para subir/leer comprobantes adjuntos)
MS_CERT_PATH=storage/app/private/entra/control-pedidos.pem
MS_CERT_THUMBPRINT=
MS_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"
MS_DOMINIOS=plasticoscarmen.com
MS_REMITENTE=reportesbi@plasticoscarmen.com

# Sitio de SharePoint donde viven las listas dim_ y fact_
SP_HOST=plasticoscarmenbo.sharepoint.com
SP_SITIO=/sites/NOMBRE-DEL-SITIO

# ------------------------------------------------------------------ correo
# log: los correos se escriben en storage/logs (demo)
# graph: se envian por Microsoft Graph como MS_REMITENTE (produccion)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="reportesbi@plasticoscarmen.com"
MAIL_FROM_NAME="Plásticos Carmen · Pedidos"

VITE_APP_NAME="${APP_NAME}"
